<Window x:Class="EasyBlue.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="EasyBlue" Icon="Assets/EasyBlue.ico" Width="860" Height="640" MinWidth="600" MinHeight="420" Background="{DynamicResource Background}" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI, Malgun Gothic" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True" Loaded="OnLoaded" Closing="OnClosing">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="136"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0"><DockPanel>
<StackPanel DockPanel.Dock="Bottom" Margin="12"><TextBlock x:Name="UsbLabel" Text="USB 검색 대기" FontSize="11" Foreground="{DynamicResource Muted}"/><TextBlock Text="EasyBlue Next 0.3.0" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,6,0,0"/></StackPanel>
<ListBox x:Name="Navigation" SelectionChanged="Navigate" BorderThickness="0" Background="Transparent" SelectedIndex="0" Margin="0,10,0,0"><ListBoxItem Content="▣   기기 관리"/><ListBoxItem Content="⌨   입력 설정"/><ListBoxItem Content="⚙   일반 설정"/><ListBoxItem Content="⌁   진단"/></ListBox></DockPanel></Border>
<DockPanel Grid.Column="1" Margin="16,12">
<Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="0,8,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="준비 중" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/><Button x:Name="ReturnButton" Grid.Column="1" Content="PC 복귀 · Ctrl+Alt+F12" Click="ReturnClick" FontSize="11" Margin="8,0,0,0"/></Grid></Border>
<Grid>
<ScrollViewer x:Name="DevicePage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="기기 관리" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="붙이면 자동 전환 · 떨어뜨리면 수동 전환" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="ScanButton" Content="↻" ToolTip="장치와 페어링 목록 새로고침" Click="ScanClick" Width="30" Padding="0" Margin="0,0,6,0"/><Button x:Name="PairButton" Content="＋ 새 기기 페어링" Style="{StaticResource Primary}" Click="PairClick"/></StackPanel></Grid>
<Border Grid.Row="1" Height="340" BorderBrush="{DynamicResource Border}" BorderThickness="1" Background="{DynamicResource Panel}" CornerRadius="7" ClipToBounds="True"><Grid><Canvas x:Name="LayoutCanvas" Background="Transparent" SizeChanged="CanvasResized" MouseMove="CanvasMove" MouseLeftButtonUp="CanvasUp" LostMouseCapture="CanvasCaptureLost"/><Button Content="화면 크기" Click="SizesClick" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" FontSize="11" Padding="7,2"/><TextBlock Text="기기를 드래그해 배치 · 붙은 경계에서 자동 전환" FontSize="10" Foreground="{DynamicResource Muted}" IsHitTestVisible="False" VerticalAlignment="Bottom" Margin="9,5"/></Grid></Border>
<DockPanel Grid.Row="2" Margin="0,10,0,6"><Button Content="동글 이름 변경…" Click="DongleSettingsClick" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="11"/><TextBlock Text="등록된 기기" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
<Border Grid.Row="3" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource Panel}"><StackPanel><TextBlock x:Name="EmptyLabel" Text="페어링된 기기가 없습니다. 위의 새 기기 페어링을 눌러 추가하세요." Foreground="{DynamicResource Muted}" Margin="10"/><ItemsControl x:Name="DeviceList"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="8,5"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/><ColumnDefinition Width="52"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}"/><Button Content="{Binding Shortcut}" Tag="{Binding Id}" Click="EditDeviceShortcut" FontSize="10" Padding="4,1" MinHeight="20" HorizontalAlignment="Left" ToolTip="이 기기로 전환할 단축키 지정"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{Binding Position}" FontSize="11"/><TextBlock Text="{Binding Mode}" FontSize="10" Foreground="{DynamicResource Muted}"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding Connection}" FontSize="11" VerticalAlignment="Center"/><Button Grid.Column="3" Content="전환" Tag="{Binding Id}" Click="SwitchClick" Padding="5,2" MinHeight="24" FontSize="11"/><Button Grid.Column="4" Content="설정" Tag="{Binding Id}" Click="EditDeviceClick" Padding="0" Margin="4,0,0,0" MinHeight="24" ToolTip="기기 이름·화면 크기·배치 설정"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
<StackPanel Grid.Row="4" Margin="0,7,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="가장자리 자동 전환" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock Text="대기(초)" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="DwellBox" Text="0.5" Width="44" LostFocus="DwellChanged" MinHeight="24" Padding="4,2"/></StackPanel><CheckBox Grid.Column="2" x:Name="AutoToggle" Style="{StaticResource SmallToggle}" Click="AutoChanged" AutomationProperties.Name="가장자리 자동 전환"/></Grid><TextBlock x:Name="AutoStatus" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,3"/><CheckBox x:Name="AvoidDragBox" Content="드래그 중 전환 안 함" FontSize="11" Click="AvoidDragChanged"/></StackPanel>
</Grid></ScrollViewer>
<ScrollViewer x:Name="InputPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="입력 설정" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="입력 전환" FontWeight="SemiBold"/><TextBlock Text="기기별 단축키는 기기 관리에서 지정합니다. PC 복귀와 마지막 기기 연결에 같은 조합을 지정하면 서로 오갑니다." Margin="0,8,0,12"/><TextBlock Text="PC 복귀 단축키"/><TextBox x:Name="ReturnShortcutBox" IsReadOnly="True" PreviewKeyDown="ShortcutKey" GotKeyboardFocus="ShortcutFocus" LostKeyboardFocus="ShortcutBlur" Margin="0,4,0,8" ToolTip="클릭한 뒤 Ctrl / Alt / Win을 포함한 조합을 누르세요"/>
<TextBlock Text="마지막 기기 연결 단축키"/><TextBox x:Name="LastShortcutBox" IsReadOnly="True" PreviewKeyDown="ShortcutKey" GotKeyboardFocus="ShortcutFocus" LostKeyboardFocus="ShortcutBlur" Margin="0,4,0,8"/>
<Button Content="단축키 기본값 복원" Click="ResetShortcuts" HorizontalAlignment="Left" Margin="0,0,0,12"/><TextBlock Text="마우스 속도"/><Slider x:Name="SpeedSlider" Minimum="0.25" Maximum="2" Value="1" TickFrequency="0.25" IsSnapToTickEnabled="True" Margin="0,8" ValueChanged="InputSettingsChanged"/><TextBlock Text="스크롤 속도"/><Slider x:Name="WheelSlider" Minimum="0.25" Maximum="3" Value="1" TickFrequency="0.25" IsSnapToTickEnabled="True" Margin="0,8" ValueChanged="InputSettingsChanged"/><CheckBox x:Name="AccelerationBox" Content="빠르게 움직일 때 마우스 가속" Click="InputSettingsChanged"/><CheckBox x:Name="KoreanBox" Content="한/영 키를 Ctrl+Space로 전송" Click="InputSettingsChanged"/><TextBlock Text="휴대폰에서는 가상 커서 위치를 추적합니다. 폰의 터치나 마우스 가속으로 위치가 어긋나면 PC 복귀 후 다시 전환하세요." Foreground="{DynamicResource Muted}" FontSize="12"/></StackPanel></Border></StackPanel></ScrollViewer>
<ScrollViewer x:Name="GeneralPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="일반 설정" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="화면 테마" FontWeight="SemiBold"/><WrapPanel Margin="0,6,0,10"><RadioButton x:Name="SystemTheme" Content="시스템 설정 따르기" Tag="System" GroupName="Theme" Click="ThemeClick"/><RadioButton x:Name="LightTheme" Content="라이트" Tag="Light" GroupName="Theme" Click="ThemeClick"/><RadioButton x:Name="DarkTheme" Content="다크" Tag="Dark" GroupName="Theme" Click="ThemeClick"/></WrapPanel><TextBlock Text="글자 크기" FontWeight="SemiBold"/><WrapPanel Margin="0,6"><Button Content="작게" Tag="12" Click="FontClick" Margin="0,0,6,0"/><Button Content="기본" Tag="13" Click="FontClick" Margin="0,0,6,0"/><Button Content="크게" Tag="15" Click="FontClick"/></WrapPanel><TextBlock Text="테마와 글자 크기, 기기 배치는 자동으로 저장됩니다." Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,8,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><CheckBox x:Name="StartupBox" Content="Windows 시작 시 트레이에서 실행" Click="StartupChanged"/><CheckBox x:Name="LedBox" Content="EasyBlue 동글 LED 켜기" Click="LedChanged"/><TextBlock Text="모니터 크기" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBlock Text="모니터 위치는 Windows에서 읽습니다. 인치 크기는 기본 27인치이며 실제 크기로 조정할 수 있습니다." Margin="0,8" Foreground="{DynamicResource Muted}"/><Button Content="기존 특수키·클립보드 설정…" Click="OpenLegacyClick" HorizontalAlignment="Left" Margin="0,8"/><Button Content="화면 크기 설정…" Click="SizesClick" HorizontalAlignment="Left"/></StackPanel></Border></StackPanel></ScrollViewer>
<ScrollViewer x:Name="DiagnosticsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="진단" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/><TextBlock x:Name="DiagnosticText" Text="장치 검색 결과를 표시합니다." Foreground="{DynamicResource Muted}"/><Button Content="진단 저장…" Click="SaveDiagnostics" HorizontalAlignment="Left" Margin="0,12"/><TextBlock Text="현재 독립 통신은 B002 장치를 지원합니다. 기존 EasyBlue와 동시에 장치를 제어하지 않도록 기존 앱을 종료해 주세요." Margin="0,10"/><Button Content="기존 EasyBlue 선택하여 열기…" Click="OpenLegacyClick" HorizontalAlignment="Left"/></StackPanel></ScrollViewer>
</Grid></DockPanel></Grid></Window>
